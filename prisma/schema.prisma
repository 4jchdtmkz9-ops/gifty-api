generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  telegramId  String   @unique
  username    String?
  firstName   String?
  lastName    String?
  photoUrl    String?
  balanceGram Decimal  @default(0) @db.Decimal(20, 9)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallets                Wallet[]
  gifts                  Gift[]
  buyerTransactions      Transaction[]    @relation("BuyerTransactions")
  sellerTransactions     Transaction[]    @relation("SellerTransactions")
  buyerOffers            Offer[]          @relation("BuyerOffers")
  sellerOffers           Offer[]          @relation("SellerOffers")
  createdPvpRooms        PvpRoom[]        @relation("PvpRoomCreator")
  wonPvpRooms            PvpRoom[]        @relation("PvpRoomWinner")
  pvpParticipations      PvpParticipant[]
  sentPvpInvitations     PvpInvitation[]  @relation("PvpInvitationSender")
  receivedPvpInvitations PvpInvitation[]  @relation("PvpInvitationRecipient")
  botDeposits            BotDeposit[]
  botWithdrawals         BotWithdrawal[]
}

model BotDeposit {
  id             String    @id @default(cuid())
  userId         String
  requestedTon   Decimal   @db.Decimal(20, 9)
  receivedTon    Decimal?  @db.Decimal(20, 9)
  depositAddress String
  walletAddress  String
  comment        String    @unique
  txHash         String?   @unique
  status         String    @default("PENDING")
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model BotWithdrawal {
  id            String    @id @default(cuid())
  userId        String
  amountTon     Decimal   @db.Decimal(20, 9)
  destination   String
  comment       String    @unique
  status        String    @default("PENDING")
  walletSeqno   Int?
  externalHash  String?   @unique
  txHash         String?   @unique
  failureReason String?
  submittedAt   DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Wallet {
  id          String   @id @default(cuid())
  address     String   @unique
  network     String   @default("TON")
  isConnected Boolean  @default(true)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gift {
  id             String   @id @default(cuid())
  name           String
  collection     String
  emoji          String?
  priceTon       Decimal  @db.Decimal(20, 9)
  backdropName   String?
  backdropColor  String?
  symbolName     String?
  symbolImageUrl String?
  status         String   @default("LISTED")
  ownerId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  offers       Offer[]
}

model Transaction {
  id        String  @id @default(cuid())
  type      String
  status    String  @default("PENDING")
  amountTon Decimal @db.Decimal(20, 9)

  giftId String?
  gift   Gift?   @relation(fields: [giftId], references: [id], onDelete: SetNull)

  buyerId String?
  buyer   User?   @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: SetNull)

  sellerId String?
  seller   User?   @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: SetNull)

  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id        String  @id @default(cuid())
  amountTon Decimal @db.Decimal(20, 9)
  status    String  @default("PENDING")

  giftId String
  gift   Gift   @relation(fields: [giftId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String?
  seller   User?   @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PvpRoom {
  id              String    @id @default(cuid())
  code            String    @unique
  stakeGram       Decimal   @db.Decimal(20, 9)
  status          String    @default("WAITING")
  isPublic        Boolean   @default(false)
  arenaMode       String    @default("CLASSIC")
  winnerId        String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  countdownEndsAt DateTime?
  completedAt     DateTime?

  creatorId    String
  creator      User             @relation("PvpRoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  winner       User?            @relation("PvpRoomWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  participants PvpParticipant[]
  invitations  PvpInvitation[]

  @@index([isPublic, arenaMode, status, createdAt])
}

model PvpParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  stakeGram Decimal  @default(0) @db.Decimal(20, 9)
  joinedAt  DateTime @default(now())

  room PvpRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, joinedAt])
}

model PvpInvitation {
  id          String   @id @default(cuid())
  roomId      String
  senderId    String
  recipientId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room      PvpRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User    @relation("PvpInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User    @relation("PvpInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([roomId, recipientId])
  @@index([recipientId, status, createdAt])
}
